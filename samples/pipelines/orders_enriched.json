{
  "formatVersion": 1,
  "name": "orders_enriched",
  "nodes": [
    {
      "id": "read_orders",
      "type": "source",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "data": {
        "label": "Orders CSV",
        "componentId": "src.file.csv",
        "properties": {
          "path": "samples/data/orders.csv",
          "header": true
        },
        "alias": "orders"
      }
    },
    {
      "id": "read_customers",
      "type": "source",
      "position": {
        "x": 0.0,
        "y": 180.0
      },
      "data": {
        "label": "Customers CSV",
        "componentId": "src.file.csv",
        "properties": {
          "path": "samples/data/customers.csv",
          "header": true
        },
        "alias": "customers"
      }
    },
    {
      "id": "filter_recent",
      "type": "transform",
      "position": {
        "x": 280.0,
        "y": 0.0
      },
      "data": {
        "label": "Orders from 2026",
        "componentId": "xf.filter",
        "properties": {
          "predicate": "order_ts >= '2026-01-01'"
        }
      }
    },
    {
      "id": "join_customers",
      "type": "transform",
      "position": {
        "x": 560.0,
        "y": 90.0
      },
      "data": {
        "label": "Attach customer",
        "componentId": "xf.join",
        "properties": {
          "type": "inner",
          "keys": [
            "customer_id"
          ]
        }
      }
    },
    {
      "id": "write_parquet",
      "type": "sink",
      "position": {
        "x": 840.0,
        "y": 90.0
      },
      "data": {
        "label": "Enriched orders",
        "componentId": "snk.file.parquet",
        "properties": {
          "path": "samples/out/orders_enriched.parquet",
          "mode": "overwrite",
          "compression": "zstd"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "read_orders",
      "target": "filter_recent",
      "sourceHandle": "main",
      "targetHandle": "in"
    },
    {
      "id": "e2",
      "source": "filter_recent",
      "target": "join_customers",
      "sourceHandle": "main",
      "targetHandle": "left"
    },
    {
      "id": "e3",
      "source": "read_customers",
      "target": "join_customers",
      "sourceHandle": "main",
      "targetHandle": "right"
    },
    {

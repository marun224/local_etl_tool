{
  "formatVersion": 1,
  "name": "nats_orders",
  "nodes": [
    {
      "id": "read_orders",
      "type": "source",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "data": {
        "label": "Orders stream",
        "componentId": "src.stream.nats",
        "properties": {
          "url": "${nats_url}",
          "stream": "${stream}",
          "start": "earliest",
          "max_records": 1000,
          "columns": {
            "order_id": "INTEGER",
            "customer_id": "VARCHAR",
            "order_ts": "TIMESTAMP",
            "amount": "DECIMAL(10,2)",
            "status": "VARCHAR",
            "_subject": "VARCHAR",
            "_sequence": "BIGINT",
            "_timestamp": "TIMESTAMP"
          }
        },
        "alias": "orders"
      }
    },
    {
      "id": "large_only",
      "type": "transform",
      "position": {
        "x": 280.0,
        "y": 0.0
      },
      "data": {
        "label": "Over 100",
        "componentId": "xf.filter",
        "properties": {
          "predicate": "amount > 100"
        }
      }
    },
    {
      "id": "write_large",
      "type": "sink",
      "position": {
        "x": 560.0,
        "y": 0.0
      },
      "data": {
        "label": "Large orders",
        "componentId": "snk.file.parquet",
        "properties": {
          "path": "${workspace}/samples/out/nats_large_orders.parquet",
          "mode": "overwrite"
        }
      }
    },
    {
      "id": "publish_large",
      "type": "sink",
      "position": {
        "x": 560.0,
        "y": 160.0
      },
      "data": {
        "label": "Large orders subject",
        "componentId": "snk.stream.nats",
        "properties": {
          "url": "${nats_url}",
          "subject": "${large_subject}",
          "msg_id_column": "order_id"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "read_orders",
      "target": "large_only",
      "sourceHandle": "main",
      "targetHandle": "in"
    },
    {
      "id": "e2",
      "source": "large_only",
      "target": "write_large",
      "sourceHandle": "main",
      "targetHandle": "in"
    },
    {
      "id": "e3",
      "source": "large_only",
      "target": "publish_large",
      "sourceHandle": "main",
      "targetHandle": "in"
    }
  ],
  "parameters": {
    "nats_url": {
      "type": "string",
      "required": true,
      "default": "nats://127.0.0.1:54222",
      "description": "The NATS server. The committed default is the open test server scripts/test-services.ps1 starts."
    },
    "stream": {
      "type": "string",
      "required": true,
      "default": "ORDERS",
      "description": "The JetStream stream to read. Each run reads what arrived since the last successful one."
    },
    "large_subject": {
      "type": "string",
      "required": true,
      "default": "large.orders",
      "description": "Where the large orders are published, with order_id as the message ID so a re-run adds no copies. A stream must capture it."
    }
  }
}

{
  "formatVersion": 1,
  "name": "orders_incremental",
  "nodes": [
    {
      "id": "read_orders",
      "type": "source",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "data": {
        "label": "Orders CSV",
        "componentId": "src.file.csv",
        "properties": {
          "path": "${workspace}/samples/data/orders.csv",
          "header": true,
          "delimiter": ","
        },
        "alias": "orders",
        "incremental": {
          "column": "order_ts"
        }
      }
    },
    {
      "id": "write_parquet",
      "type": "sink",
      "position": {
        "x": 280.0,
        "y": 0.0
      },
      "data": {
        "label": "New orders Parquet",
        "componentId": "snk.file.parquet",
        "properties": {
          "path": "${workspace}/samples/out/orders_incremental.parquet",
          "mode": "overwrite",
          "compression": "zstd"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "read_orders",
      "target": "write_parquet",
      "sourceHandle": "main",
      "targetHandle": "in"
    }
  ]
}
